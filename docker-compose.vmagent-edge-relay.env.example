#@ Placement
#-  - EDGE_VM_PLACEMENT_CONSTRAINT -
#-    Pin the relay to the node holding its local persistent queue volume.
EDGE_VM_PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
#@ Resource Limits
#-  - EDGE_VM_MEMORY_LIMIT -
#-    Hard container memory limit. Measure usage during normal traffic and catch-up.
EDGE_VM_MEMORY_LIMIT=700M
#@ Container Config
#-  - EDGE_VM_PUBLISHED_PORT -
#-    Host port serving /api/v1/write, /metrics and /health.
#-    Reuse the old relay's published port after stopping its service.
EDGE_VM_PUBLISHED_PORT=9090
#-  - EDGE_VM_BASIC_AUTH_USER / EDGE_VM_BASIC_AUTH_PASS -
#-    Optional receiver basic authentication. Set both or leave both empty.
#-    PASS is a plain password, not a bcrypt hash. Default self-scraping uses it too.
EDGE_VM_BASIC_AUTH_USER=
EDGE_VM_BASIC_AUTH_PASS=
#-  - EDGE_VM_MAX_DISK_USAGE -
#-    Maximum persistent queue size per upstream URL; 0 means unlimited.
#-    Oldest buffered blocks are dropped when full. Increase for longer outages.
EDGE_VM_MAX_DISK_USAGE=1GB
#-  - EDGE_VM_PROM_SCRAPE_CONFIG -
#-    Optional complete Prometheus scrape YAML, starting with global/scrape_configs.
#-    Empty uses a 15s authenticated self-scrape with job vmagent-edge-relay.
#-    A custom config replaces the default; retain a self-scrape for relay alerts.
EDGE_VM_PROM_SCRAPE_CONFIG=
#-  - EDGE_VM_RELABEL_CONFIG -
#-    Optional YAML list of remote-write relabel rules applied to received and scraped data.
#-    Empty forwards labels unchanged. Keep node identity and relay telemetry labels.
EDGE_VM_RELABEL_CONFIG=
#@ Upstream Config
#-  - UPSTREAM_REMOTE_WRITE_URL -
#-    Required full Prometheus-compatible remote-write URL, including any path prefix.
#-    Example: http://grafana-stack-prometheus:9090/prom/api/v1/write
UPSTREAM_REMOTE_WRITE_URL=
#-  - UPSTREAM_BASIC_AUTH_USER / UPSTREAM_BASIC_AUTH_PASS -
#-    Optional upstream basic authentication. Set both or leave both empty.
#-    PASS is a plain password, not a bcrypt hash.
UPSTREAM_BASIC_AUTH_USER=
UPSTREAM_BASIC_AUTH_PASS=
