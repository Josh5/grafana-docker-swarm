#@ Placement
#-    Configure a placement constraint to where the container will be run.
#-    Examples:
#-        - node.hostname==<hostname>
#-        - engine.labels.fs-access.<worker-hostname>.mnt==true
#-        - node.role!=manager
EDGE_PROM_PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
#@ Host Config
#-  - TZ -
#-    The timezone.
TZ=Etc/UTC
#@ Resource Limits
#-  - EDGE_PROM_MEMORY_LIMIT -
#-    Container memory limit. Large existing WALs may need extra recovery headroom.
EDGE_PROM_MEMORY_LIMIT=700M
#-  - EDGE_PROM_GOMEMLIMIT_RATIO -
#-    Go soft memory target as a fraction of the container limit (greater than 0, at most 1).
#-    0.70 leaves headroom; lower values can increase garbage collection CPU.
EDGE_PROM_GOMEMLIMIT_RATIO=0.70
#@ Container Paths
#-  - EDGE_PROM_DATA_PATH -
#-    The Path to the Prometheus data directory
EDGE_PROM_DATA_PATH=./appdata/prometheus-edge-relay
#@ Prometheus Config
#-  - EDGE_PROM_PUBLISHED_PORT -
#-    The published port for the remote_write receiver
EDGE_PROM_PUBLISHED_PORT=9090
#-  - EDGE_PROM_RETENTION_TIME -
#-    Maximum age of buffered samples before WAL truncation discards them.
#-    Does not skip startup replay of an existing WAL. Shortening can lose unsent samples.
EDGE_PROM_RETENTION_TIME=6h
#-  - EDGE_PROM_SCRAPE_INTERVAL -
#-    Scrape interval for built-in self-scrape
EDGE_PROM_SCRAPE_INTERVAL=15s
#-  - EDGE_PROM_EVAL_INTERVAL -
#-    Evaluation interval for rules
EDGE_PROM_EVAL_INTERVAL=15s
#-  - EDGE_PROM_EXTERNAL_LABELS -
#-    External labels block appended under global.external_labels.
#-    Must be indented 4 spaces, e.g.:
#-      edge: "edge-1"
EDGE_PROM_EXTERNAL_LABELS=
#-  - EDGE_PROM_ADDITIONAL_SCRAPE_CONFIGS -
#-    Additional scrape_configs entries appended under scrape_configs.
#-    Must be indented 2 spaces, e.g.:
#-      - job_name: node
#-        static_configs:
#-          - targets: ["node-exporter:9100"]
EDGE_PROM_ADDITIONAL_SCRAPE_CONFIGS=
#-  - EDGE_PROM_ENABLE_SELF_SCRAPE -
#-    Enable scraping the relay's own metrics
EDGE_PROM_ENABLE_SELF_SCRAPE=true
#-  - EDGE_PROM_BASIC_AUTH_USER -
#-    Optional basic auth username for the receiver
EDGE_PROM_BASIC_AUTH_USER=
#-  - EDGE_PROM_BASIC_AUTH_PASS_HASH -
#-    Bcrypt hash for the receiver password (required if user is set).
#-      > import getpass
#-      > import bcrypt
#-      > password = getpass.getpass("password: ")
#-      > hashed_password = bcrypt.hashpw(password.encode("utf-8"), bcrypt.gensalt())
#-      > print(hashed_password.decode())
EDGE_PROM_BASIC_AUTH_PASS_HASH=
#@ Upstream Config
#-  - UPSTREAM_PROMETHEUS_REMOTE_WRITE_URL -
#-    Upstream Prometheus remote_write URL. Must include scheme and path.
#-    Examples:
#-      http://grafana-stack-prometheus:9090/prom/api/v1/write
#-      http://192.168.1.201:9090/api/v1/write
UPSTREAM_PROMETHEUS_REMOTE_WRITE_URL=
#-  - UPSTREAM_PROMETHEUS_BASIC_AUTH_USER -
#-    Optional username for upstream basic auth (set with PASS).
UPSTREAM_PROMETHEUS_BASIC_AUTH_USER=
#-  - UPSTREAM_PROMETHEUS_BASIC_AUTH_PASS -
#-    Optional password for upstream basic auth (set with USER).
UPSTREAM_PROMETHEUS_BASIC_AUTH_PASS=
#@ Remote Write Queue
#-    Defaults favour small deployments. Increase gradually when delivery lag grows.
#-  - EDGE_PROM_REMOTE_WRITE_MIN_SHARDS -
#-    Initial number of parallel send queues; must not exceed MAX_SHARDS.
EDGE_PROM_REMOTE_WRITE_MIN_SHARDS=1
#-  - EDGE_PROM_REMOTE_WRITE_MAX_SHARDS -
#-    Maximum parallel send queues. Try 8 for higher throughput; Prometheus defaults to 50.
EDGE_PROM_REMOTE_WRITE_MAX_SHARDS=4
#-  - EDGE_PROM_REMOTE_WRITE_CAPACITY -
#-    Pending samples per shard. Keep at least 3 times MAX_SAMPLES_PER_SEND.
EDGE_PROM_REMOTE_WRITE_CAPACITY=3000
#-  - EDGE_PROM_REMOTE_WRITE_MAX_SAMPLES_PER_SEND -
#-    Maximum samples per request. Try 2000 with capacity 6000 for larger deployments.
EDGE_PROM_REMOTE_WRITE_MAX_SAMPLES_PER_SEND=1000
#-  - EDGE_PROM_REMOTE_WRITE_BATCH_SEND_DEADLINE -
#-    Flush a partial batch after this interval; full batches are sent immediately.
EDGE_PROM_REMOTE_WRITE_BATCH_SEND_DEADLINE=5s
#-  - UPSTREAM_PROMETHEUS_REMOTE_WRITE_CONFIG -
#-    Extra remote_write config appended under the same remote_write item.
#-    Must be indented 4 spaces. An explicit queue_config replaces all queue variables above.
#-    For example:
#-      write_relabel_configs:
#-        - source_labels: [__name__]
#-          regex: ".*"
UPSTREAM_PROMETHEUS_REMOTE_WRITE_CONFIG=
