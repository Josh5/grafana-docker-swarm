#@ Placement
#-    Configure a placement constraint to where the container will be run.
#-    Examples:
#-        - node.hostname==<hostname>
#-        - engine.labels.fs-access.<worker-hostname>.mnt==true
#-        - node.role!=manager
GRAFANA_PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
PROMETHEUS_PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
#-    LOKI_PLACEMENT_CONSTRAINT must select exactly one node for Loki and
#-    its gateway; their generated-config volume is local to that node.
#-    Example: node.hostname==monitor-1
LOKI_PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
#@ Host Config
#-  - TZ -
#-    The timezone.
TZ=Etc/UTC
#@ Traefik Config
#-  - TRAEFIK_DOMAIN -
#-    The Domiain where Grafana is accessed.
TRAEFIK_DOMAIN=localhost:3000
#-  - TRAEFIK_SCHEME -
#-    The public URL scheme used by Traefik.
TRAEFIK_SCHEME=http
#-  - TRAEFIK_PATH_PREFIX_GRAFANA -
#-    The optional prefix for accessing grafana. Leave empty to serve from TRAEFIK_DOMAIN.
TRAEFIK_PATH_PREFIX_GRAFANA=/monitor
#-  - TRAEFIK_PATH_PREFIX_PROMETHEUS -
#-    The prefix for accessing prometheus' API
TRAEFIK_PATH_PREFIX_PROMETHEUS=/prom
#-  - TRAEFIK_PATH_PREFIX_LOKI -
#-    The prefix for accessing loki's API
TRAEFIK_PATH_PREFIX_LOKI=/logs
#@ Container Paths
#-  - GRAFANA_DATA_PATH -
#-    The Path to the Grafana config directory
GRAFANA_DATA_PATH=./appdata/grafana
#-  - PROMETHEUS_DATA_PATH -
#-    The Path to the Prometheus config directory
PROMETHEUS_DATA_PATH=./appdata/prometheus
#-  - ALERTMANAGER_DATA_PATH -
#-    The Path to the Alertmanager storage directory
ALERTMANAGER_DATA_PATH=./appdata/alertmanager
#-  - LOKI_DATA_PATH -
#-    The Path to the Loki storage directory
LOKI_DATA_PATH=./appdata/loki
#@ Loki Resources
#-  - LOKI_MEMORY_LIMIT -
#-    Memory limit for the monolithic Loki service.
#-    Before changing this or the reservation, record the Loki dashboard's
#-    memory chunks, flush queue, compaction/retention success and query latency
#-    under representative load. Use the Loki dashboard's Loki Upgrade Health row.
LOKI_MEMORY_LIMIT=1.5G
#-  - LOKI_MEMORY_RESERVATION -
#-    Memory reservation for the monolithic Loki service.
LOKI_MEMORY_RESERVATION=500M
#@ Prometheus Config
#-  - PROMETHEUS_DEBUGGING -
#-    Enable debugging
PROMETHEUS_DEBUGGING=false
#-  - PROMETHEUS_BASIC_AUTH_USER -
#-    Add a basic auth username to the API
PROMETHEUS_BASIC_AUTH_USER=admin
#-  - PROMETHEUS_BASIC_AUTH_PASS -
#-    Add a password for the PROMETHEUS_BASIC_AUTH_USER
PROMETHEUS_BASIC_AUTH_PASS=mySecretPassword
#-  - PROMETHEUS_BASIC_AUTH_PASS_HASH -
#-    The bcrypt hash of the PROMETHEUS_BASIC_AUTH_PASS
#-      > import getpass
#-      > import bcrypt
#-      > password = getpass.getpass("password: ")
#-      > hashed_password = bcrypt.hashpw(password.encode("utf-8"), bcrypt.gensalt())
#-      > print(hashed_password.decode())
PROMETHEUS_BASIC_AUTH_PASS_HASH=$2y$10$osUVO0tt8IygF7.M3PibIuVFY3TNnusNyjEZ.br3w.tHPhSd7lpsa
#-  - PROMETHEUS_ENABLE_REMOTE_WRITE_RECEIVER -
#-    Enable remote write receiver mode
PROMETHEUS_ENABLE_REMOTE_WRITE_RECEIVER=false
#@ Loki Config
#-    The gateway writes a non-secret template before waiting for Loki.
#-    Loki expands the variables below at startup; credentials are not rendered
#-    by the gateway. The shared config volume is created automatically.
#-    AWS: LOKI_OBJECT_STORE=s3 and LOKI_S3_USE_MINIO=false.
#-    MinIO: LOKI_OBJECT_STORE=s3 and LOKI_S3_USE_MINIO=true.
#-    Azure: LOKI_OBJECT_STORE=azure; the S3 settings are unused.
#-    Set the selected backend's connection values and redeploy to apply changes.
#-  - LOKI_USERNAME -
#-    The username for Grafana Loki.
#-    This auth is only applied for traffic from traefik.
LOKI_USERNAME=client
#-  - LOKI_PASSWORD_HASH -
#-    The hash of the password for Grafana Loki.
#-    This auth is only applied for traffic from traefik.
#-    Generate this with:
#-      > echo -n "Enter password for user '${LOKI_USERNAME:?}': " \
#-      >   && read -s password \
#-      >   && echo "'${password}'" \
#-      >   && sudo docker run --rm httpd htpasswd -nb ${LOKI_USERNAME:?} ${password}
LOKI_PASSWORD_HASH='$apr1$wcCsl.As$SAbn61uxmjxbeyRs29eZk0'
#-  - LOKI_OBJECT_STORE -
#-    Object storage backend for Loki. Supported values: s3, azure.
#-    Defaults to s3. MinIO also uses s3; select it with LOKI_S3_USE_MINIO.
LOKI_OBJECT_STORE=s3
#-  - LOKI_S3_USE_MINIO -
#-    Boolean, true or false; defaults to false. Used only for the s3 backend.
#-    true selects MinIO-compatible HTTP access with path-style bucket addressing.
#-    false selects AWS S3 using its regional endpoint and normal TLS validation.
LOKI_S3_USE_MINIO=false
#-  - LOKI_S3_ENDPOINT -
#-    Required for MinIO: host:port without a URL scheme, credentials or bucket.
#-    Used only when LOKI_S3_USE_MINIO=true; that mode currently uses HTTP.
LOKI_S3_ENDPOINT=<HOST_IP>:9000
#-  - LOKI_S3_BUCKET_NAME -
#-    Existing bucket name, required for both AWS S3 and MinIO.
#-    The stack does not create the bucket.
LOKI_S3_BUCKET_NAME=loki-data
#-  - AWS_REGION -
#-    Region hosting the AWS S3 bucket; set it for AWS deployments.
#-    MinIO uses this signing region, falling back to us-east-1 when empty.
#-    Unused for Azure.
AWS_REGION=eu-west-1
#-  - ACCESS_KEY_ID -
#-    S3/MinIO access key ID. Supply together with SECRET_ACCESS_KEY.
#-    For AWS IAM instance-role credentials, leave both access-key fields empty
#-    and allow Loki to reach the instance metadata service. Required for MinIO.
ACCESS_KEY_ID=loki
#-  - SECRET_ACCESS_KEY -
#-    S3/MinIO secret access key, supplied as a deployment-time environment value.
#-    It is a separate config field; do not URI-encode it. Unused for Azure.
SECRET_ACCESS_KEY=supersecret
#-  - LOKI_AZURE_STORAGE_ACCOUNT_NAME -
#-    Required Azure Storage account name when LOKI_OBJECT_STORE=azure.
LOKI_AZURE_STORAGE_ACCOUNT_NAME=
#-  - LOKI_AZURE_STORAGE_ACCOUNT_KEY -
#-    Required Azure Storage account key when LOKI_OBJECT_STORE=azure.
#-    Supply as a deployment-time environment value; S3 credentials are unused.
LOKI_AZURE_STORAGE_ACCOUNT_KEY=
#-  - LOKI_AZURE_STORAGE_CONTAINER_NAME -
#-    Existing Azure Blob container when LOKI_OBJECT_STORE=azure; defaults to loki.
#-    Prepare the container and its access permissions before deploying.
LOKI_AZURE_STORAGE_CONTAINER_NAME=loki
#-  - LOKI_GRPC_SERVER_MAX_RECV_MSG_SIZE -
#-    Limit on the size of a gRPC message this server can receive (bytes).
#-    Empty uses 20971520 bytes (20 MiB). Also applied to the frontend client.
LOKI_GRPC_SERVER_MAX_RECV_MSG_SIZE=
#-  - LOKI_GRPC_SERVER_MAX_SEND_MSG_SIZE -
#-    Limit on the size of a gRPC message this server can send (bytes).
#-    Empty uses 20971520 bytes (20 MiB). Also applied to the frontend client.
LOKI_GRPC_SERVER_MAX_SEND_MSG_SIZE=
#-  - LOKI_REJECT_OLD_SAMPLES_MAX_AGE -
#-    Maximum age of log entries accepted at ingestion.
#-    Useful for delayed/replayed logs from stalled agents.
#-    This is not retention.
LOKI_REJECT_OLD_SAMPLES_MAX_AGE=7d
#-  - LOKI_MAX_CHUNK_AGE -
#-    Maximum time an ingester keeps a log chunk open; this is not retention.
#-    Loki accepts an out-of-order log only if it is within half this value of
#-    the newest entry in the same label stream. The 2h default allows a 1h
#-    window; 4h allows 2h, and 24h allows 12h.
#-    A rejected entry produces a log line like:
#-      entry with timestamp <timestamp> ignored, reason: 'entry too far behind,
#-      entry timestamp is: <timestamp>, oldest acceptable timestamp is: <timestamp>'
#-    Larger values retain more unflushed chunks in ingester memory and require
#-    querying ingesters over the same longer window, which can increase memory
#-    use, query load, and query latency. Prefer fixing delayed log delivery or
#-    separating independent sources into stable-label streams before increasing it.
LOKI_MAX_CHUNK_AGE=2h
#-  - LOKI_RETENTION_PERIOD -
#-    How long Loki keeps stored logs before retention cleanup.
#-    Requires compactor.retention_enabled=true.
LOKI_RETENTION_PERIOD=90d
